# Postgres
POSTGRES_USER=multas
POSTGRES_PASSWORD=changeme
POSTGRES_DB=multas

# Backend — usa el host:puerto interno de Docker (5432), aunque fuera se
# publique en 5435
DATABASE_URL=postgresql://multas:changeme@db:5432/multas
SECRET_KEY=cambia-esto-por-algo-aleatorio-largo
CORS_ORIGINS=http://localhost:3004

# Secret para crear el único admin vía POST /api/v1/auth/bootstrap.
# Genera algo aleatorio, úsalo una vez y luego puedes dejarlo o rotarlo.
BOOTSTRAP_SECRET=cambia-esto-tambien
